{
  "github.copilot.editor.enableAutoCompletions": false,
  "window.commandCenter": false,
  "files.autoSave": "afterDelay",
  "editor.fontSize": 18,
  "redhat.telemetry.enabled": true,
  "window.menuBarVisibility": "toggle",
  "workbench.navigationControl.enabled": false,
  "workbench.layoutControl.enabled": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "explorer.confirmDelete": false,
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 110,
  "editor.wrappingIndent": "indent",
  "editor.rulers": [110],
  "prettier.printWidth": 110,
  "prettier.trailingComma": "all",
  "editor.breadcrumbs.enabled": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
  },
  "editor.quickSuggestions": {
    "strings": "on",
  },
  "errorLens.enabledDiagnosticLevels": ["error"],
  "errorLens.excludeBySource": ["cSpell", "eslint"],
  "errorLens.margin": "2ch",
  "errorLens.fontStyleItalic": true,
  "workbench.activityBar.location": "bottom",
  "workbench.editor.showTabs": "multiple",
  "editor.minimap.enabled": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.renderLineHighlight": "none",
  "editor.guides.indentation": false,
  "editor.folding": false,
  "editor.lineNumbers": "on",
  "workbench.statusBar.visible": true,
  "editor.lightbulb.enabled": "off",
  "editor.overviewRulerBorder": false,
  "debug.breakpointsView.presentation": "tree",
  "editor.fontFamily": "JetBrains Mono",
  "explorer.confirmDragAndDrop": false,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
    "*.csproj": "${capture}.csproj.user",
    "*.json": "${capture}.Development.json",
    "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
    "*.razor": "${capture}.razor.cs,${capture}.razor.css",
    "*.resx": "${capture}.Designer.cs",
    "*.xaml": "${capture}.xaml.cs",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "git.openRepositoryInParentFolders": "never",
  "git.confirmSync": false,
  "chat.tips.enabled": false,
  "chat.viewSessions.orientation": "stacked",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "csharp": false
  },
  "workbench.iconTheme": "symbols",
}
